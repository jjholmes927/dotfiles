#!/usr/bin/env bash

want="${1:-}"
root="${ENG_ROOT:-$HOME/engineering}"
sess=''
if [ -n "${TMUX_PANE:-}" ]; then
  sess=$(tmux display-message -p -t "$TMUX_PANE" '#{session_id}' 2>/dev/null)
elif [ -n "${TMUX:-}" ]; then
  sess="\$${TMUX##*,}"
fi
pane_of() {
  tmux list-panes -t "$1" -F '#{pane_id} #{pane_left} #{pane_top} #{pane_current_command}' 2>/dev/null |
    awk '$2 == 0 { if (!seen || $3 + 0 < top + 0) { seen = 1; top = $3; id = $1; cmd = $4 } } END { if (seen) print id, cmd }'
}

kind_of() {
  local p="$1" c="$2" pid kids
  case "$c" in
    python|Python|python3) echo fleet; return ;;
    bash|zsh|sh|-bash|-zsh|-sh) echo none; return ;;
  esac
  pid=$(tmux display-message -p -t "$p" '#{pane_pid}' 2>/dev/null)
  case "$pid" in ''|*[!0-9]*) echo native; return ;; esac
  kids=$(ps -eo ppid=,command= 2>/dev/null | awk -v pp="$pid" '$1 + 0 == pp + 0 { $1 = ""; print }')
  case "$kids" in
    '') echo native ;;
    *"claude agents"*) echo native ;;
    *fleet*) echo fleet ;;
    *) echo other ;;
  esac
}

candidates=''
named=$(pane_of "${sess}:deck")
[ -n "$named" ] && candidates="${sess}:deck $named name"
scan=$(tmux list-panes -s -t "$sess" -F '#{window_id} #{?@deck,1,0} #{window_panes} #{pane_id} #{pane_left} #{pane_top} #{pane_current_command}' 2>/dev/null)
tagged=$(printf '%s\n' "$scan" | awk '
  $5 == 0 && (!(($1) in top) || $6 + 0 < top[$1] + 0) { top[$1] = $6; id[$1] = $4; tag[$1] = $2; cmd[$1] = $7 }
  END { for (w in id) if (tag[w] == 1) print w, id[w], cmd[w], "tag" }
')
[ "$(printf '%s' "$tagged" | grep -c .)" = 1 ] && candidates="${candidates}${candidates:+
}$tagged"
shaped=$(printf '%s\n' "$scan" | awk '
  $5 == 0 && (!(($1) in top) || $6 + 0 < top[$1] + 0) { top[$1] = $6; id[$1] = $4; cmd[$1] = $7 }
  END { for (w in id) print w, id[w], cmd[w], "shape" }
')

win=''
pane=''
cur=''
route=''
while read -r w p c r _; do
  [ -n "$p" ] || continue
  k=$(kind_of "$p" "$c")
  case "$k" in fleet|native|none) win="$w"; pane="$p"; cur="$k"; route="$r"; break ;; esac
done <<EOF
$candidates
EOF

if [ -z "$pane" ]; then
  hits=''''
  while read -r w p c r _; do
    [ -n "$p" ] || continue
    k=$(kind_of "$p" "$c")
    case "$k" in fleet|native) hits="${hits}${hits:+
}$w $p $k" ;; esac
  done <<EOF
$shaped
EOF
  if [ "$(printf '%s' "$hits" | grep -c .)" != 1 ]; then
    echo "no 'deck' window in this session — run deck first"; exit 1
  fi
  win=$(printf '%s\n' "$hits" | awk '{ print $1 }')
  pane=$(printf '%s\n' "$hits" | awk '{ print $2 }')
  cur=$(printf '%s\n' "$hits" | awk '{ print $3 }')
  route=shape
fi

if [ "$route" != name ]; then
  name=$(tmux display-message -p -t "$win" '#{window_name}' 2>/dev/null)
  echo "deck window is named '${name}' — found its inbox by $route"
fi
tmux set-option -w -t "$win" @deck 1 2>/dev/null
case "$want" in
  fleet|native) ;;
  '') case "$cur" in fleet) want=native ;; *) want=fleet ;; esac ;;
  *) echo "usage: fleet-toggle [fleet|native]"; exit 1 ;;
esac
if [ "$want" = "$cur" ]; then
  echo "deck inbox already showing $want"; exit 0
fi
if [ "$cur" != none ]; then
  tries=0
  while [ "$tries" -lt 2 ]; do
    if [ "$cur" = fleet ]; then
      tmux send-keys -t "$pane" q
    else
      tmux send-keys -t "$pane" C-c
      sleep 0.3
      tmux send-keys -t "$pane" C-c
    fi
    waits=0
    while [ "$waits" -lt 3 ]; do
      sleep 1
      cmd=$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null)
      case "$cmd" in bash|zsh|sh|-bash|-zsh|-sh) break 2 ;; esac
      waits=$((waits + 1))
    done
    tries=$((tries + 1))
  done
  case "$cmd" in
    bash|zsh|sh|-bash|-zsh|-sh) ;;
    *) echo "deck inbox pane still running '$cmd' after 2 tries — quit it by hand"; exit 1 ;;
  esac
fi
tmux send-keys -t "$pane" C-u
if [ "$want" = fleet ]; then
  tmux send-keys -t "$pane" 'fleet' C-m
else
  tmux send-keys -t "$pane" "claude agents --cwd \"$root\" --dangerously-skip-permissions" C-m
fi
echo "deck inbox: $cur -> $want"
