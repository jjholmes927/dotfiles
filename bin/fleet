PEEK_RATIO = 0.8
PEEK_MIN_HEIGHT = 6
PEEK_MIN_WIDTH = 24
BOX_PADDING = 6
ATTACH_WAIT = 4.0
ANSWER_DELAY = 0.7
QUESTION_PATTERN = re.compile(r"^[\s│┃|]*❯?\s*1\.")
WINDOW_ID_PATTERN = re.compile(r"@\d+")
BELL_BUCKETS = ("BLOCKED", "COMPLETE")
PEEK_FOOTER = "any key close"
GATE_FOOTER = "1-9 answer · any other key close"
NO_QUESTION_FOOTER = "no numbered question detected — Enter to pair in"
NO_TMUX_FOOTER = "answering needs tmux — any key close"
EMPTY_PEEK = "(no assistant text in the transcript yet)"
EMPTY_CAPTURE = "(the attached pane rendered nothing)"


class FleetError(Exception):
    pass


def cell_width(text):
    return sum(2 if unicodedata.east_asian_width(char) in WIDE_WIDTHS else 1 for char in text or "")


def _clip(text, width):
    if width <= 0:
        return ""
    if cell_width(text) <= width:
        return text
    if width == 1:
        return text[:1]
    used = 0
    kept = []
    for char in text:
        step = 2 if unicodedata.east_asian_width(char) in WIDE_WIDTHS else 1
        if used + step > width - 1:
            break
        kept.append(char)
        used += step
    return "".join(kept) + "…"


def _flatten(text):
    return text.replace("\t", " ").replace("\r", " ").replace("\n", " ")


def _run(args, timeout=10):
    try:
        proc = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode != 0:
        return None
    return proc.stdout.decode("utf-8", "replace")


def run_out(args, timeout=10):
    try:
        proc = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
    except subprocess.TimeoutExpired:
        return TIMEOUT_RC, "timed out after %ss" % timeout
    except (OSError, subprocess.SubprocessError) as error:
        return 127, str(error)
    return proc.returncode, proc.stdout.decode("utf-8", "replace")


def _is_under(path, root):
    if not path or not root:
        return False
    path = os.path.normpath(path)
    root = os.path.normpath(root)
    return path == root or path.startswith(root + os.sep)


def lane_for_cwd(cwd, eng_root=None):
    root = os.path.normpath(eng_root or ENG_ROOT)
    if not _is_under(cwd, root):
        return ""
    rest = os.path.normpath(cwd)[len(root) :].strip(os.sep)
    if not rest:
        return ""
    return rest.split(os.sep)[0]


def fetch_sessions(eng_root, timeout=10):
    out = _run(["claude", "agents", "--json", "--all"], timeout=timeout)
    if out is None:
        raise FleetError("claude agents --json --all failed")
    try:
        rows = json.loads(out)
    except ValueError:
        raise FleetError("claude agents --json --all returned non-JSON")
    if not isinstance(rows, list):
        raise FleetError("claude agents --json --all returned unexpected shape")
    return [
        row
        for row in rows
        if isinstance(row, dict)
        and row.get("kind") == "background"
        and _is_under(row.get("cwd"), eng_root)
    ]


def read_sidecars(dir_path):
    sidecars = {}
    try:
        names = os.listdir(dir_path)
    except OSError:
        return sidecars
    for name in names:
        if name.endswith(".tmp"):
            continue
        try:
            with open(os.path.join(dir_path, name), "r", encoding="utf-8", errors="replace") as handle:
                line = handle.readline()
        except OSError:
            continue
        fields = line.rstrip("\r\n").split("\t")
        if len(fields) != 3:
            continue
        sidecars[name] = (fields[0], fields[1], fields[2])
    return sidecars


def derive_bucket(cli_state, cli_status, sidecar):
    state = (cli_state or "").strip().lower()
    activity = (cli_status or "").strip().lower()
    if state == "working":
        return "WORKING"
    if state == "blocked" and activity != "idle":
        return "BLOCKED"
    recorded = (sidecar[0].strip().lower() if sidecar else "")
    if state == "blocked":
        return "COMPLETE" if recorded == "complete" else "AWAITING"
    if state in ("done", "stopped") and recorded == "complete":
        return "COMPLETE"
    if state == "done":
        return "AWAITING"
    return "STOPPED"


def parse_pr(note):
    if not note:
        return None
    match = PR_PATTERN.search(note)
    if not match:
        return None
    return "#" + match.group(1)


def read_stars(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            return set(line.strip() for line in handle if line.strip())
    except OSError:
        return set()


def toggle_star(path, session_id):
    stars = read_stars(path)
    if session_id in stars:
        stars.discard(session_id)
    else:
        stars.add(session_id)
    parent = os.path.dirname(path)
    tmp = path + ".tmp"
    try:
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as handle:
            for entry in sorted(stars):
                handle.write(entry + "\n")
        os.replace(tmp, path)
    except OSError:
        pass
    return stars


def format_age(started_at, now=None):
    try:
        started = float(started_at) / 1000.0
    except (TypeError, ValueError):
        return "?"
    elapsed = int((time.time() if now is None else now) - started)
    if elapsed < 0:
        elapsed = 0
    if elapsed < 60:
        return "%ds" % elapsed
    if elapsed < 3600:
        return "%dm" % (elapsed // 60)
    if elapsed < 86400:
        return "%dh" % (elapsed // 3600)
    return "%dd" % (elapsed // 86400)


def lane_status(root, timeout=10):
    name = os.path.basename(os.path.normpath(root))
    branch = _run(["git", "-C", root, "branch", "--show-current"], timeout=timeout)
    porcelain = _run(["git", "-C", root, "status", "--porcelain"], timeout=timeout)
    worktrees = _run(["git", "-C", root, "worktree", "list"], timeout=timeout)
    if branch is None or porcelain is None or worktrees is None:
        return {"name": name, "root": root, "error": True}
    return {
        "name": name,
        "root": root,
        "branch": branch.strip() or "detached",
        "dirty": bool(porcelain.strip()),
        "worktrees": max(len([line for line in worktrees.splitlines() if line.strip()]) - 1, 0),
        "error": False,
    }


def build_model(sessions, sidecars, stars, lanes):
    stars = set(stars or ())
    counts = dict((bucket, 0) for bucket in BUCKET_ORDER)
    buckets = dict((bucket, []) for bucket in BUCKET_ORDER)
    for session in sessions:
        session_id = session.get("sessionId") or ""
        sidecar = sidecars.get(session_id)
        activity = (session.get("context_text") or session.get("status") or "").strip()
        cli_status = session.get("cli_status", session.get("status"))
        bucket = derive_bucket(session.get("state"), cli_status, sidecar)
        settled = bucket in ("COMPLETE", "AWAITING", "STOPPED")
        note = sidecar[2] if (sidecar and settled) else ""
        cwd = session.get("cwd") or ""
        started_at = session.get("startedAt")
        row = {
            "session_id": session_id,
            "short": session.get("id") or session_id[:8],
            "name": session.get("name") or "(unnamed)",
            "cwd": cwd,
            "lane": lane_for_cwd(cwd),
            "state": session.get("state") or "",
            "bucket": bucket,
            "started_at": started_at,
            "age": format_age(started_at),
            "note": note,
            "pr": parse_pr(note),
            "starred": session_id in stars,
            "context": (note or activity) if settled else activity,
        }
        counts[bucket] += 1
        buckets[bucket].append(row)
    groups = []
    for bucket in BUCKET_ORDER:
        rows = buckets[bucket]
        if not rows:
            continue
        rows.sort(key=lambda row: (not row["starred"], _sort_key(row["started_at"]), row["name"]))
        groups.append((bucket, rows))
    return {"counts": counts, "lanes": list(lanes or []), "groups": groups}


def _sort_key(started_at):
    try:
        return float(started_at)
    except (TypeError, ValueError):
        return float("inf")


def count_segments(counts):
    segments = []
    column = 0
    for bucket in BUCKET_ORDER:
        if not (counts or {}).get(bucket):
            continue
        if segments:
            column += len(COUNT_SEPARATOR)
        text = "%d %s" % (counts[bucket], bucket)
        segments.append((column, text, bucket))
        column += len(text)
    return segments


def format_counts(counts, width):
    segments = count_segments(counts)
    joined = COUNT_SEPARATOR.join(text for _column, text, _bucket in segments)
    return _clip(joined if segments else "no streams", width)


def _lane_cell(lane):
    name = lane.get("name") or "?"
    if lane.get("error"):
        return "%s ?" % name
    worktrees = lane.get("worktrees") or 0
    if lane.get("dirty"):
        return "%s DIRTY·%d" % (name, worktrees) if worktrees else "%s DIRTY" % name
    return "%s ✓%d" % (name, worktrees) if worktrees else "%s ✓" % name


def format_lane_strip(lanes, width):
    if not lanes:
        return []
    indent = " " * len(LANE_LABEL)
    lines = []
    current = LANE_LABEL
    for lane in lanes:
        cell = _lane_cell(lane)
        if current in (LANE_LABEL, indent):
            current += cell
        elif len(current) + 2 + len(cell) > width:
            lines.append(current)
            current = indent + cell
        else:
            current += "  " + cell
    lines.append(current)
    return [_clip(line, width) for line in lines]


def pr_badge(row):
    number = row.get("pr")
    return ("PR %s" % number) if number else ""


def lane_marks(line):
    return [
        (match.start(), match.group(), LANE_MARK_COLORS[match.group()])
        for match in LANE_MARK_PATTERN.finditer(line or "")
    ]


def row_parts(row, width):
    glyph = STAR_GLYPH if row.get("starred") else ROW_GLYPH
    short = (row.get("short") or "")[:8]
    age = row.get("age") or ""
    badge = pr_badge(row)
    tail = age + ("  " + badge if badge else "")
    head = "%s %-8s " % (glyph, short)
    room = max(width - len(head) - len(tail) - 1, 8)
    name = _clip(row.get("name") or "", room)
    tail_column = len(head) + room + 1
    parts = [(0, glyph, "glyph"), (2, short, "short"), (len(head), name, "name"), (tail_column, age, "age")]
    if badge:
        parts.append((tail_column + len(age) + 2, badge, "badge"))
    text = _clip(head + name.ljust(room) + " " + tail, width)
    return [part for part in parts if part[1]], text


def row_context(row):
    return strip_markdown(_flatten(row.get("context") or "")).strip()


def format_row(row, width, selected=False):
    lines = [row_parts(row, width)[1]]
    if width >= NARROW_WIDTH:
        lines.append(_clip(CONTEXT_INDENT + row_context(row), width))
    return lines


def _content_text(content):
    if isinstance(content, str):
        return content.strip()
    if not isinstance(content, list):
        return ""
    chunks = []
    for block in content:
        if isinstance(block, dict) and block.get("type") == "text" and block.get("text"):
            chunks.append(block["text"])
    return "\n".join(chunks).strip()


def transcript_path(cwd, session_id):
    return os.path.join(PROJECTS_DIR, SLUG_PATTERN.sub("-", cwd or ""), session_id + ".jsonl")


def transcript_tail(cwd, session_id):
    path = transcript_path(cwd, session_id)
    try:
        size = os.stat(path).st_size
    except OSError:
        return ""
    return _tail_assistant_text(path, size)


def strip_visual(text):
    return CONTROL_PATTERN.sub(" ", ANSI_PATTERN.sub("", text or ""))


def strip_markdown(text):
    return MARKDOWN_PATTERN.sub("", text or "")


def sanitize_context(text):
    return BLANK_PATTERN.sub(" ", strip_markdown(strip_visual(text))).strip()


def capture_lines(text):
    lines = [strip_visual(line).rstrip() for line in (text or "").splitlines()]
    while lines and not lines[-1]:
        lines.pop()
    return lines


def has_question(lines):
    return any(QUESTION_PATTERN.match(line) for line in lines)


def wrap_block(lines, width):
    if width <= 0:
        return []
    wrapped = []
    for line in lines:
        if not line.strip():
            wrapped.append("")
            continue
        indent = line[: len(line) - len(line.lstrip())][: max(width - 1, 0)]
        wrapped.extend(textwrap.wrap(line, width, subsequent_indent=indent) or [""])
    return wrapped


def _tail_assistant_text(path, size):
    try:
        with open(path, "rb") as handle:
            if size > TAIL_BYTES:
                handle.seek(size - TAIL_BYTES)
                partial = True
            else:
                partial = False
            window = handle.read()
    except OSError:
        return ""
    lines = window.split(b"\n")
    if partial and lines:
        lines = lines[1:]
    for raw in reversed(lines):
        line = raw.decode("utf-8", "replace").strip()
        if not line:
            continue
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if not isinstance(entry, dict) or entry.get("type") != "assistant":
            continue
        message = entry.get("message")
        text = _content_text(message.get("content") if isinstance(message, dict) else None)
        if text:
            return text
    return ""


def transcript_context(cwd, session_id, cache):
    if not session_id:
        return ""
    path = transcript_path(cwd, session_id)
    try:
        info = os.stat(path)
    except OSError:
        return ""
    stamp = (info.st_mtime_ns, info.st_size)
    cached = cache.get(path)
    if cached and cached[0] == stamp:
        return cached[1]
    text = sanitize_context(_tail_assistant_text(path, info.st_size))
    if not text and cached and cached[1]:
        text = cached[1]
    cache[path] = (stamp, text)
    return text


def worktree_parts(cwd):
    parts = os.path.normpath(cwd or "").split(os.sep)
    found = None
    for index in range(len(parts)):
        for container in WORKTREE_CONTAINERS:
            if tuple(parts[index : index + len(container)]) != container:
                continue
            name_index = index + len(container)
            if index == 0 or name_index >= len(parts):
                continue
            found = (index, name_index)
    if found is None:
        return None
    index, name_index = found
    root = os.sep.join(parts[:index]) or os.sep
    path = os.sep.join(parts[: name_index + 1])
    return root, path, parts[name_index]


def worktree_branch(path, timeout=ACTION_TIMEOUT):
    rc, text = run_out(["git", "-C", path, "rev-parse", "--abbrev-ref", "HEAD"], timeout)
    if rc != 0:
        return None
    branch = sanitize_context(text)
    if not branch or branch == "HEAD":
        return ""
    return branch


def worktree_hint(cwd):
    parts = worktree_parts(cwd)
    if not parts:
        return ""
    root, path, _name = parts
    if not os.path.isdir(path):
        return ""
    branch = worktree_branch(path)
    if branch is None:
        return "worktree dir left behind: %s" % path
    command = "git -C %s worktree remove %s" % (shlex.quote(root), shlex.quote(path))
    if branch:
        command += " && git -C %s branch -D %s" % (shlex.quote(root), shlex.quote(branch))
    return "worktree not reaped: %s" % command


def lane_roots(sessions):
    names = list(LANES)
    seen = set(names)
    for session in sessions:
        name = lane_for_cwd(session.get("cwd") or "")
        if not name or name in seen:
            continue
        root = os.path.join(ENG_ROOT, name)
        if not os.path.exists(os.path.join(root, ".git")):
            continue
        seen.add(name)
        names.append(name)
    return [os.path.join(ENG_ROOT, name) for name in names]


class FleetState(object):
    def __init__(self):
        self.sessions = []
        self.lanes = []
        self.model = {"counts": {}, "lanes": [], "groups": []}
        self.rows = []
        self.tails = {}
        self.stale_since = ""
        self.selected = 0
        self.selected_id = ""
        self.top = 0
        self.sessions_at = None
        self.lanes_at = None
        self.colors = {}
        self.message = ""
        self.buckets = None


def refresh_model(state, now=None, lanes=False, timeout=10):
    now = time.monotonic() if now is None else now
    try:
        state.sessions = fetch_sessions(ENG_ROOT, timeout=timeout)
        state.stale_since = ""
    except FleetError:
        if not state.stale_since:
            state.stale_since = time.strftime("%H:%M")
    state.sessions_at = now
    if lanes or state.lanes_at is None:
        state.lanes = [lane_status(root, timeout=timeout) for root in lane_roots(state.sessions)]
        state.lanes_at = now
    remodel(state)
    ring_bell(state)


def bell_check(state):
    current = dict((row["session_id"], row["bucket"]) for row in state.rows)
    previous = state.buckets
    state.buckets = current
    if previous is None:
        return False
    return any(
        bucket in BELL_BUCKETS and previous.get(session_id) != bucket for session_id, bucket in current.items()
    )


def ring_bell(state):
    if not bell_check(state):
        return
    try:
        curses.beep()
    except curses.error:
        pass


def remodel(state):
    enriched = []
    seen_paths = set()
    for session in state.sessions:
        cwd = session.get("cwd") or ""
        session_id = session.get("sessionId") or ""
        seen_paths.add(transcript_path(cwd, session_id))
        item = dict(session)
        item["context_text"] = transcript_context(cwd, session_id, state.tails) or sanitize_context(
            item.get("status") or ""
        )
        enriched.append(item)
    for path in [known for known in state.tails if known not in seen_paths]:
        del state.tails[path]
    state.model = build_model(enriched, read_sidecars(SIDECAR_DIR), read_stars(STARS_PATH), state.lanes)
    state.rows = [row for _, rows in state.model["groups"] for row in rows]
    restore_selection(state)


def restore_selection(state):
    if not state.rows:
        state.selected = 0
        state.selected_id = ""
        state.top = 0
        return
    for index, row in enumerate(state.rows):
        if state.selected_id and row["session_id"] == state.selected_id:
            state.selected = index
            return
    state.selected = max(0, min(state.selected, len(state.rows) - 1))
    state.selected_id = state.rows[state.selected]["session_id"]


def selected_row(state):
    if not state.rows or not 0 <= state.selected < len(state.rows):
        return None
    return state.rows[state.selected]


def move_selection(state, delta):
    if not state.rows:
        return
    state.selected = max(0, min(state.selected + delta, len(state.rows) - 1))
    state.selected_id = state.rows[state.selected]["session_id"]


def format_banner(state, width):
    text = format_counts(state.model.get("counts") or {}, width)
    if state.stale_since:
        text = _clip("%s  ·  stale since %s" % (text, state.stale_since), width)
    return text


def format_group_header(bucket, width):
    prefix = "%s%s " % (HEADER_PREFIX, bucket)
    rule = min(width, HEADER_WIDTH)
    if rule <= len(prefix):
        return _clip(prefix, width)
    return prefix + "─" * (rule - len(prefix))


def body_lines(state, width):
    lines = []
    index = 0
    for bucket, rows in state.model.get("groups") or []:
        lines.append(("", "spacer", None, -1))
        lines.append((format_group_header(bucket, width), "header", bucket, -1))
        for position, row in enumerate(rows):
            if position:
                lines.append(("", "spacer", None, -1))
            for offset, text in enumerate(format_row(row, width, index == state.selected)):
                lines.append((text, "row" if offset == 0 else "context", row, index))
            index += 1
    return lines


def scroll_top(lines, selected, top, height):
    if height <= 0 or not lines:
        return 0
    spots = [position for position, line in enumerate(lines) if line[3] == selected]
    if spots:
        if spots[0] < top:
            top = spots[0]
        if spots[-1] >= top + height:
            top = spots[-1] - height + 1
    return max(0, min(top, max(0, len(lines) - height)))


def color_attr(state, name, bold=True):
    attr = state.colors.get(name, curses.A_NORMAL)
    if bold and name != "dim":
        attr |= curses.A_BOLD
    return attr


def bucket_attr(state, bucket, bold=True):
    return color_attr(state, BUCKET_COLORS.get(bucket, "dim"), bold)


def part_attr(state, role, row):
    if role == "glyph":
        return color_attr(state, "yellow") if row.get("starred") else bucket_attr(state, row.get("bucket"))
    if role == "name":
        return curses.A_BOLD if row.get("bucket") == "BLOCKED" else curses.A_NORMAL
    if role == "badge":
        return color_attr(state, "green")
    return color_attr(state, "dim")


def line_attr(state, kind, payload, chosen):
    if kind == "spacer":
        return curses.A_NORMAL
    if kind == "header":
        return color_attr(state, "dim")
    attr = curses.A_NORMAL
    if kind == "context":
        attr |= curses.A_DIM
    if chosen:
        attr |= curses.A_REVERSE
    return attr


def _put(screen, y, x, text, attr, width):
    room = width - x
    if room <= 0 or not text:
        return
    try:
        screen.addnstr(y, x, text, room, attr)
    except curses.error:
        pass


def _put_part(screen, y, x, text, attr, line, width):
    if x < 0 or x + len(text) > len(line):
        return
    _put(screen, y, x, text, attr, width)


def paint(screen, state):
    screen.erase()
    height, width = screen.getmaxyx()
    if height < 4 or width < 20:
        _put(screen, 0, 0, "fleet needs a bigger window", curses.A_NORMAL, max(width - 1, 1))
        screen.noutrefresh()
        curses.doupdate()
        return
    banner = format_banner(state, width)
    _put(screen, 0, 0, banner, color_attr(state, "dim"), width)
    for column, text, bucket in count_segments(state.model.get("counts") or {}):
        _put_part(screen, 0, column, text, bucket_attr(state, bucket), banner, width)
    stale = banner.find(STALE_PREFIX)
    if stale >= 0:
        _put(screen, 0, stale, banner[stale:], color_attr(state, "yellow"), width)
    y = 2
    for line in format_lane_strip(state.lanes, width):
        _put(screen, y, 0, line, curses.A_NORMAL, width)
        for column, mark, name in lane_marks(line):
            _put_part(screen, y, column, mark, color_attr(state, name), line, width)
        y += 1
    region = height - 1 - y - (1 if state.message else 0)
    lines = body_lines(state, width)
    state.top = scroll_top(lines, state.selected, state.top, region)
    for offset, (text, kind, payload, index) in enumerate(lines[state.top : state.top + max(region, 0)]):
        chosen = index == state.selected and index >= 0
        attr = line_attr(state, kind, payload, chosen)
        _put(screen, y + offset, 0, text, attr, width)
        if kind == "header":
            _put_part(screen, y + offset, len(HEADER_PREFIX), payload, bucket_attr(state, payload), text, width)
        elif kind == "row":
            reverse = curses.A_REVERSE if chosen else 0
            for column, chunk, role in row_parts(payload, width)[0]:
                _put_part(screen, y + offset, column, chunk, part_attr(state, role, payload) | reverse, text, width)
    if state.message:
        attr = color_attr(state, "yellow")
        _put(screen, height - 2, 0, _clip(_flatten(state.message), width - 1), attr, width - 1)
    _put(screen, height - 1, 0, _clip(FOOTER, width - 1), curses.A_DIM, width - 1)
    screen.noutrefresh()
    curses.doupdate()


def status_line(screen, text, attr):
    height, width = screen.getmaxyx()
    if height < 1 or width < 2:
        return False
    try:
        screen.move(height - 1, 0)
        screen.clrtoeol()
    except curses.error:
        pass
    _put(screen, height - 1, 0, _clip(text, width - 1), attr, width - 1)
    screen.noutrefresh()
    curses.doupdate()
    return True


def confirm(screen, prompt):
    if not status_line(screen, "%s [y/N]" % prompt, curses.A_REVERSE):
        return False
    screen.timeout(-1)
    curses.flushinp()
    try:
        key = screen.getch()
    finally:
        screen.timeout(POLL_MS)
    return key in (ord("y"), ord("Y"))


def note_line(screen, prompt, text, height, width):
    try:
        screen.move(height - 2, 0)
        screen.clrtoeol()
    except curses.error:
        pass
    line = _clip(prompt + text, width - 1)
    _put(screen, height - 2, 0, line, curses.A_REVERSE, width - 1)
    try:
        screen.move(height - 2, min(cell_width(line), width - 1))
    except curses.error:
        pass
    screen.noutrefresh()
    curses.doupdate()


def read_note(screen, prompt):
    height, width = screen.getmaxyx()
    if height < 2 or width < 4:
        return ""
    typed = bytearray()
    cancelled = False
    screen.timeout(-1)
    curses.flushinp()
    try:
        curses.curs_set(1)
    except curses.error:
        pass
    try:
        while True:
            note_line(screen, prompt, typed.decode("utf-8", "replace"), height, width)
            key = screen.getch()
            if key in ENTER_KEYS:
                break
            if key == ESCAPE_KEY:
                cancelled = True
                break
            if key in BACKSPACE_KEYS:
                if typed:
                    typed.pop()
            elif 32 <= key <= 255 and len(typed) < NOTE_LIMIT:
                typed.append(key)
    finally:
        screen.timeout(POLL_MS)
        try:
            curses.curs_set(0)
        except curses.error:
            pass
    if cancelled:
        return None
    return typed.decode("utf-8", "replace")


def overlay(screen, title, lines, footer, fit=False):
    height, width = screen.getmaxyx()
    if height < PEEK_MIN_HEIGHT or width < PEEK_MIN_WIDTH:
        return -1
    box_height = max(int(height * PEEK_RATIO), PEEK_MIN_HEIGHT)
    box_width = max(int(width * PEEK_RATIO), PEEK_MIN_WIDTH)
    if fit:
        widest = max([cell_width(text) for text in list(lines) + [title, footer]] or [0])
        box_width = max(min(box_width, widest + BOX_PADDING), PEEK_MIN_WIDTH)
        box_height = max(min(box_height, len(wrap_block(lines, box_width - 4)) + 2), PEEK_MIN_HEIGHT)
    try:
        window = curses.newwin(box_height, box_width, (height - box_height) // 2, (width - box_width) // 2)
    except curses.error:
        return -1
    window.keypad(True)
    window.erase()
    try:
        window.box()
    except curses.error:
        pass
    inner = box_width - 4
    room = box_height - 2
    _put(window, 0, 2, _clip(" %s " % title, inner), curses.A_BOLD, box_width - 1)
    body = wrap_block(lines, inner)
    for offset, text in enumerate(body[max(len(body) - room, 0) :]):
        _put(window, 1 + offset, 2, text, curses.A_NORMAL, box_width - 1)
    _put(window, box_height - 1, 2, _clip(" %s " % footer, inner), curses.A_DIM, box_width - 1)
    window.noutrefresh()
    curses.doupdate()
    window.timeout(-1)
    curses.flushinp()
    try:
        key = window.getch()
    finally:
        screen.clearok(True)
        screen.touchwin()
    return key


def peek_title(row):
    return ("%s %s" % (row.get("short") or "", row.get("name") or "")).strip()


def gate_answer(screen, row, short):
    rc, text = run_out(
        ["tmux", "new-window", "-d", "-P", "-F", "#{window_id}", "claude attach %s" % short], TMUX_TIMEOUT
    )
    window = sanitize_context(text)
    if rc == TIMEOUT_RC or (rc == 0 and not window):
        return ORPHAN_WINDOW_WARNING % short, ""
    if rc != 0:
        return "tmux new-window failed: %s" % (window or "no window id"), ""
    if not WINDOW_ID_PATTERN.fullmatch(window):
        return ORPHAN_WINDOW_WARNING % short, ""
    try:
        status_line(screen, "attaching to %s …" % short, curses.A_REVERSE)
        time.sleep(ATTACH_WAIT)
        rc, pane = run_out(["tmux", "capture-pane", "-t", window, "-p"], TMUX_TIMEOUT)
        if rc != 0:
            return "tmux capture-pane failed: %s" % sanitize_context(pane), ""
        lines = capture_lines(pane)
        answerable = has_question(lines)
        key = overlay(
            screen, peek_title(row), lines or [EMPTY_CAPTURE], GATE_FOOTER if answerable else NO_QUESTION_FOOTER
        )
        if not answerable:
            return ("", "pair") if key in ENTER_KEYS else ("", "")
        if not ord("1") <= key <= ord("9"):
            return "", ""
        digit = chr(key)
        rc, text = run_out(["tmux", "send-keys", "-t", window, digit], TMUX_TIMEOUT)
        if rc != 0:
            return "tmux send-keys %s failed: %s" % (digit, sanitize_context(text)), ""
        time.sleep(ANSWER_DELAY)
        rc, text = run_out(["tmux", "send-keys", "-t", window, "Enter"], TMUX_TIMEOUT)
        if rc != 0:
            return "tmux send-keys Enter failed: %s" % sanitize_context(text), ""
        return "answered %s with %s" % (short, digit), "refresh"
    finally:
        run_out(["tmux", "kill-window", "-t", window], TMUX_TIMEOUT)


def peek(screen, row):
    blocked = row.get("bucket") == "BLOCKED"
    short = row.get("short") or ""
    if blocked and short and os.environ.get("TMUX"):
        return gate_answer(screen, row, short)
    lines = capture_lines(transcript_tail(row.get("cwd"), row.get("session_id")))
    overlay(screen, peek_title(row), lines or [EMPTY_PEEK], NO_TMUX_FOOTER if blocked else PEEK_FOOTER)
    return "", ""


def pair_handoff(short):
    if not short:
        return "nothing selected"
    if not os.environ.get("TMUX"):
        return "no tmux — run: claude attach %s" % short
    rc, text = run_out(["tmux", "list-windows", "-F", "#W"], TMUX_TIMEOUT)
    if rc != 0:
        return "tmux list-windows failed: %s" % sanitize_context(text)
    if PAIR_WINDOW not in [line.strip() for line in text.splitlines()]:
        return "no pair window in this session — run deck first"
    rc, command = run_out(
        ["tmux", "display-message", "-p", "-t", PAIR_TARGET, "#{pane_current_command}"], TMUX_TIMEOUT
    )
    if rc != 0:
        return "tmux display-message failed: %s" % sanitize_context(command)
    command = sanitize_context(command)
    if command not in SHELL_COMMANDS:
        return "pair window is busy running '%s' — detach it first" % command
    for args in (
        ["tmux", "send-keys", "-t", PAIR_TARGET, "C-u"],
        ["tmux", "send-keys", "-t", PAIR_TARGET, "claude attach %s" % short, "C-m"],
        ["tmux", "select-window", "-t", PAIR_TARGET],
    ):
        rc, text = run_out(args, TMUX_TIMEOUT)
        if rc != 0:
            return "tmux %s failed: %s" % (args[1], sanitize_context(text))
    return "pair → %s" % short


def stop_session(row):
    rc, text = run_out(["claude", "stop", row["short"]], ACTION_TIMEOUT)
    if rc != 0:
        return "stop %s failed: %s" % (row["short"], sanitize_context(text))
    return "stopped %s" % row["short"]


def remove_session(row):
    rc, text = run_out(["claude", "rm", row["short"]], ACTION_TIMEOUT)
    if rc != 0:
        return "rm %s failed: %s" % (row["short"], sanitize_context(text))
    hint = worktree_hint(row.get("cwd"))
    if hint:
        return "removed %s · %s" % (row["short"], hint)
    return "removed %s" % row["short"]


def menu_items(row):
    row = row or {}
    blocked = row.get("bucket") == "BLOCKED"
    starred = bool(row.get("starred"))
    items = []
    for action, label, hint in MENU_ACTIONS:
        if action == "peek" and blocked:
            label = BLOCKED_PEEK_LABEL
        elif action == "star" and starred:
            label = UNSTAR_LABEL
        items.append((action, label, hint))
    return items


def menu_lines(items):
    room = max([len(label) for _action, label, _hint in items] or [0])
    return ["%d. %-*s (%s)" % (index, room, label, hint) for index, (_action, label, hint) in enumerate(items, 1)]


def menu_choice(key, items):
    if key in ENTER_KEYS:
        return items[0][0] if items else ""
    index = key - ord("1")
    if 0 <= index < len(items):
        return items[index][0]
    return ""


def status_note(text, action):
    return _flatten(text or "").strip() or DEFAULT_NOTES.get(action, "")


def mark_status(row, action, note):
    session_id = row.get("session_id") or ""
    rc, text = run_out(["fleet-status", "--session", session_id, "--", action, note], ACTION_TIMEOUT)
    if rc != 0:
        return "fleet-status %s failed: %s" % (action, sanitize_context(text))
    return "marked %s %s · %s" % (row.get("short") or "", action, note)


def dispatch_action(screen, state, row, action):
    if action == "pair":
        state.message = pair_handoff(row["short"])
    elif action == "peek":
        message, followup = peek(screen, row)
        if followup == "refresh":
            refresh_model(state)
        state.message = pair_handoff(row["short"]) if followup == "pair" else message
    elif action == "star":
        toggle_star(STARS_PATH, row["session_id"])
        remodel(state)
    elif action in DEFAULT_NOTES:
        typed = read_note(screen, NOTE_PROMPT % (action, row["short"]))
        if typed is None:
            state.message = NOTE_CANCELLED
        else:
            state.message = mark_status(row, action, status_note(typed, action))
            remodel(state)
    elif action == "stop":
        if confirm(screen, "stop %s?" % row["short"]):
            state.message = stop_session(row)
            refresh_model(state)
    elif action == "remove":
        if confirm(screen, "rm %s?" % row["short"]):
            state.message = remove_session(row)
            refresh_model(state)


def open_menu(screen, state, row):
    items = menu_items(row)
    key = overlay(screen, peek_title(row), menu_lines(items), MENU_FOOTER % len(items), fit=True)
    if key == -1:
        state.message = MENU_TOO_SMALL
        return
    action = menu_choice(key, items)
    if action:
        dispatch_action(screen, state, row, action)


def init_colors():
    colors = {
        "red": curses.A_BOLD,
        "yellow": curses.A_BOLD,
        "green": curses.A_BOLD,
        "cyan": curses.A_NORMAL,
        "dim": curses.A_DIM,
    }
    try:
        curses.start_color()
        curses.use_default_colors()
        for slot, (_name, color) in enumerate(COLOR_SLOTS, 1):
            curses.init_pair(slot, color, -1)
    except curses.error:
        return colors
    for slot, (name, _color) in enumerate(COLOR_SLOTS, 1):
        colors[name] = curses.color_pair(slot)
    return colors


def run(screen, state):
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    screen.timeout(POLL_MS)
    screen.keypad(True)
    state.colors = init_colors()
    refresh_model(state)
    while True:
        paint(screen, state)
        key = screen.getch()
        if key != -1:
            state.message = ""
        if key in (ord("q"), ord("Q")):
            return 0
        if key in (ord("j"), curses.KEY_DOWN):
            move_selection(state, 1)
        elif key in (ord("k"), curses.KEY_UP):
            move_selection(state, -1)
        elif key in ACTION_KEYS:
            row = selected_row(state)
            if row:
                dispatch_action(screen, state, row, ACTION_KEYS[key])
        elif key in ENTER_KEYS:
            row = selected_row(state)
            if row:
                open_menu(screen, state, row)
        elif key == ord("R"):
            refresh_model(state, lanes=True)
        elif key == curses.KEY_RESIZE:
            state.top = 0
            screen.clearok(True)
        now = time.monotonic()
        if now - state.sessions_at >= SESSION_INTERVAL:
            refresh_model(state, now=now, lanes=(now - state.lanes_at >= LANE_INTERVAL), timeout=3)


def main():
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    if not sys.stdout.isatty():
        sys.stderr.write("fleet needs a terminal\n")
        return 1
    return curses.wrapper(run, FleetState())


if __name__ == "__main__":
    sys.exit(main())
