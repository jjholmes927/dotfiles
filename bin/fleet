import unicodedata

BUCKET_ORDER = ["BLOCKED", "WORKING", "COMPLETE", "AWAITING", "STOPPED"]
ENG_ROOT = os.environ.get("ENG_ROOT", os.path.expanduser("~/engineering"))
SIDECAR_DIR = os.path.expanduser("~/.claude/fleet-status")
STARS_PATH = os.path.expanduser("~/.claude/fleet-stars")
PROJECTS_DIR = os.path.expanduser("~/.claude/projects")
LANES = (os.environ.get("LANES") or "mn1 mn2 mn3 mn4 mn5").split()
NARROW_WIDTH = 80
CONTEXT_INDENT = "      "
LANE_LABEL = "LANES  "
PR_PATTERN = re.compile(r"(?:PR\s*)?#(\d+)")
SLUG_PATTERN = re.compile(r"[^A-Za-z0-9]")
ANSI_PATTERN = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b[@-Z\\-_]")
CONTROL_PATTERN = re.compile(r"[\x00-\x1f\x7f]")
BLANK_PATTERN = re.compile(r"\s+")
MARKDOWN_PATTERN = re.compile(r"\*\*|`")
WIDE_WIDTHS = ("W", "F")
TAIL_BYTES = 65536
SESSION_INTERVAL = 3.0
LANE_INTERVAL = 15.0
POLL_MS = 250
HEADER_WIDTH = 60
HEADER_PREFIX = "── "
COUNT_SEPARATOR = " · "
STALE_PREFIX = "stale since "
ROW_GLYPH = "●"
STAR_GLYPH = "★"
COLOR_SLOTS = (
    ("red", curses.COLOR_RED),
    ("yellow", curses.COLOR_YELLOW),
    ("green", curses.COLOR_GREEN),
    ("cyan", curses.COLOR_CYAN),
)
BUCKET_COLORS = {
    "BLOCKED": "red",
    "WORKING": "cyan",
    "COMPLETE": "green",
    "AWAITING": "yellow",
    "STOPPED": "dim",
}
LANE_MARK_PATTERN = re.compile(r"DIRTY|✓|\?")
LANE_MARK_COLORS = {"DIRTY": "red", "✓": "green", "?": "yellow"}
WORKTREE_CONTAINERS = ((".worktrees",), (".claude", "worktrees"))
PAIR_WINDOW = "pair"
PAIR_TARGET = ":pair"
SHELL_COMMANDS = ("bash", "zsh", "sh")
ACTION_TIMEOUT = 20
TMUX_TIMEOUT = 5
TIMEOUT_RC = 124
ORPHAN_WINDOW_WARNING = "tmux new-window gave no window id — a hidden attach window for %s may be live (check: tmux list-windows)"
ENTER_KEYS = (curses.KEY_ENTER, 10, 13)
ESCAPE_KEY = 27
BACKSPACE_KEYS = (curses.KEY_BACKSPACE, 127, 8)
FOOTER = "[enter]actions [space]peek [j/k]move [q]quit"
MENU_ACTIONS = (
    ("pair", "pair in", "enter"),
    ("peek", "peek", "space"),
    ("complete", "mark complete", "c"),
    ("awaiting", "mark awaiting", "a"),
    ("star", "star", "p"),
    ("stop", "stop", "s"),
    ("remove", "remove", "r"),
)
ACTION_KEYS = {
    ord(" "): "peek",
    ord("c"): "complete",
    ord("a"): "awaiting",
    ord("p"): "star",
    ord("s"): "stop",
    ord("r"): "remove",
}
BLOCKED_PEEK_LABEL = "peek + answer"
UNSTAR_LABEL = "unstar"
MENU_FOOTER = "1-%d choose · any other key close"
MENU_TOO_SMALL = "window too small for the action menu"
DEFAULT_NOTES = {"complete": "marked complete from fleet", "awaiting": "marked awaiting from fleet"}
NOTE_PROMPT = "%s note for %s: "
NOTE_LIMIT = 120
