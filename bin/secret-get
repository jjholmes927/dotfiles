#!/usr/bin/env bash
set -euo pipefail

name="${1:-}"
if [[ ! "$name" =~ ^[A-Za-z0-9._-]+$ || "$name" == "." || "$name" == ".." ]]; then
  echo "secret-get: usage: secret-get <name> (letters, digits, dot, dash, underscore)" >&2
  exit 2
fi

if [[ "$(uname -s)" == Darwin ]]; then
  security find-generic-password -s "$name" -w 2>/dev/null || exit 1
  exit 0
fi

path="${SECRETS_DIR:-$HOME/.config/secrets}/$name"
[[ -f "$path" ]] || exit 1

mode="$(ls -ln "$path" | cut -c1-10)"
if [[ "${mode:4:6}" != "------" ]]; then
  echo "secret-get: $path must be mode 600 (chmod 600 '$path')" >&2
  exit 2
fi

cat "$path"
