#!/usr/bin/env bash
set +x
set -euo pipefail

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/jjholmes927-agent"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/jjholmes927-agent"
app_json="$config_dir/app.json"
reuse_margin=600

die() {
  printf 'gh-agent: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf 'usage: gh-agent <owner/repo> <gh args...>\n       gh-agent --check <owner/repo>\n' >&2
  exit 2
}

b64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

api() {
  local method=$1 path=$2 credential=$3 data=${4:-} response
  local args=(-sS -X "$method" --config - -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' -w '\n%{http_code}')
  if [ -n "$data" ]; then
    args+=(--data "$data")
  fi
  response=$(printf 'header = "Authorization: Bearer %s"\n' "$credential" | curl "${args[@]}" "https://api.github.com$path") || return 1
  status=${response##*$'\n'}
  body=${response%$'\n'*}
}

github_message() {
  printf '%s' "$body" | jq -r '.message // empty' 2>/dev/null || true
}

mint() {
  local app_id service key now header payload signature jwt installation
  app_id=$(jq -r '.id // empty' "$app_json")
  service=$(jq -r '.keychain_service // empty' "$app_json")
  [ -n "$app_id" ] && [ -n "$service" ] || die "$app_json needs id and keychain_service"
  key=$(security find-generic-password -s "$service" -a private-key -w 2>/dev/null | openssl base64 -d -A 2>/dev/null) || key=""
  case $key in
    -----BEGIN*) ;;
    *) die "no private key in the macOS Keychain (service $service, account private-key)" ;;
  esac
  now=$(date +%s)
  header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$app_id" | b64url)
  signature=$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign <(printf '%s\n' "$key") | b64url) || die "could not sign the app JWT"
  jwt="$header.$payload.$signature"
  api GET "/repos/$repo/installation" "$jwt" || die "could not reach api.github.com"
  case $status in
    200) ;;
    404) die "$slug is not installed on $repo" ;;
    301 | 307) die "$repo has been renamed or moved; use its current owner/repo" ;;
    *) die "GitHub answered $status looking up the $repo installation: $(github_message)" ;;
  esac
  installation=$(printf '%s' "$body" | jq -r '.id')
  local repository_id lookup pending
  repository_id=$(jq -r '.repository_id // empty' "$cache" 2>/dev/null || true)
  if [ -z "$repository_id" ]; then
    api POST "/app/installations/$installation/access_tokens" "$jwt" '{"permissions":{"metadata":"read"}}' || die "could not reach api.github.com"
    [ "$status" = 201 ] || die "GitHub answered $status minting a lookup token: $(github_message)"
    lookup=$(printf '%s' "$body" | jq -r '.token')
    api GET "/installation/repositories?per_page=100" "$lookup" || die "could not reach api.github.com"
    [ "$status" = 200 ] || die "GitHub answered $status listing the installation's repositories: $(github_message)"
    repository_id=$(printf '%s' "$body" | jq -r --arg repo "$repo" '.repositories[] | select((.full_name | ascii_downcase) == ($repo | ascii_downcase)) | .id')
    [ -n "$repository_id" ] || die "$slug cannot reach $repo"
  fi
  [[ $repository_id =~ ^[0-9]+$ ]] || die "unexpected repository id for $repo"
  api POST "/app/installations/$installation/access_tokens" "$jwt" "{\"repository_ids\":[$repository_id],\"permissions\":{\"pull_requests\":\"write\"}}" || die "could not reach api.github.com"
  [ "$status" = 201 ] || die "GitHub answered $status minting a token for $repo: $(github_message)"
  umask 077
  mkdir -p "$cache_dir"
  chmod 700 "$cache_dir"
  pending=$(mktemp "$cache_dir/.token.XXXXXX")
  printf '%s' "$body" | jq --argjson id "$repository_id" '{token, expires: (.expires_at | fromdateiso8601), repository_id: $id}' >"$pending" || {
    rm -f "$pending"
    die "could not cache the token"
  }
  mv -f "$pending" "$cache"
}

cached_token() {
  jq -r --argjson now "$(date +%s)" --argjson margin "$reuse_margin" 'select(.expires - $now > $margin) | .token // empty' "$cache" 2>/dev/null || true
}

check=""
if [ "${1:-}" = "--check" ]; then
  check=1
  shift
  [ $# -eq 1 ] || usage
elif [ $# -lt 2 ]; then
  usage
fi
repo=$1
shift
[[ $repo =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]] || die "expected owner/repo, got '$repo'"
[ -f "$app_json" ] || die "the agent GitHub app is not set up on this machine ($app_json is missing)"
slug=$(jq -r '.slug // "the agent GitHub app"' "$app_json") || die "cannot read $app_json"
cache="$cache_dir/${repo/\//__}.json"

token=""
[ -n "$check" ] || token=$(cached_token)
if [ -z "$token" ]; then
  mint
  token=$(jq -r '.token' "$cache")
fi
if [ -n "$check" ]; then
  api GET /installation/repositories "$token" || die "could not reach api.github.com"
  [ "$status" = 200 ] || die "GitHub answered $status listing the token's repositories: $(github_message)"
  printf '%s' "$body" | jq -r --arg slug "$slug" '.repositories[] | "\($slug) reaches \(.full_name)"'
  exit 0
fi
GH_TOKEN=$token
GH_REPO=$repo
export GH_TOKEN GH_REPO
exec gh "$@"
