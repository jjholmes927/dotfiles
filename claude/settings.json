{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://api.eu1.honeycomb.io"
  },
  "permissions": {
    "allow": [
      "Read(**/.claude/**)",
      "Read(~/.claude/**)",
      "Bash(agent-browser)",
      "Bash(agent-browser *)",
      "Bash(gh pr create*)",
      "Bash(diffocop*)",
      "Bash(rubocop*)",
      "Bash(gh api *)"
    ],
    "ask": [
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_schedule_message"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/confirm-github-posts.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "jq '{hookSpecificOutput: {hookEventName: \"PreToolUse\", updatedInput: (.tool_input | if has(\"model\") then . else . + {model: \"opus\"} end)}}'"
          }
        ]
      },
      {
        "matcher": "Skill|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/otel-workflow-ledger.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-alert.sh"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-alert.sh"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-alert.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/update-jjholmes927-plugins.sh",
            "timeout": 300,
            "async": true,
            "statusMessage": "Checking jjholmes927 plugins for updates"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "joel-workflow@jjholmes927-claude-skills": true,
    "beam-claude-skills@beam-claude-skills": true,
    "claude-md-management@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "beam-claude-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/wearebeam/beam-claude-skills.git"
      },
      "autoUpdate": true
    },
    "jjholmes927-claude-skills": {
      "source": {
        "source": "github",
        "repo": "jjholmes927/jjholmes927-claude-skills"
      },
      "autoUpdate": true
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "outputStyle": "Attention-kind",
  "viewMode": "focus",
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
