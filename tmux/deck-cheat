#!/usr/bin/env python3
"""Render deck-cheatsheet.txt with ANSI colour. The .txt stays plain so it
remains diffable and width-checkable; colour is applied at display time."""
import os, re, sys

HDR   = "\033[1;38;5;39m"
RULE  = "\033[38;5;240m"
CMD   = "\033[38;5;114m"
BODY  = "\033[38;5;250m"
CONT  = "\033[38;5;245m"
WARN  = "\033[1;38;5;203m"
CAUT  = "\033[38;5;179m"
OFF   = "\033[0m"

WARNINGS = ["BYPASS", "x2 deletes + worktree!", "FIRST 8 CHARS"]
CAUTIONS = ["FRESH", "refuses uncommitted work", "only whats waiting on YOU", "--safe"]

here = os.path.dirname(os.path.realpath(__file__))
path = os.path.join(here, "deck-cheatsheet.txt")

def emphasise(text, base):
    for w in WARNINGS:
        text = text.replace(w, WARN + w + OFF + base)
    for c in CAUTIONS:
        text = text.replace(c, CAUT + c + OFF + base)
    return text

for raw in open(path).read().split("\n"):
    line = raw.rstrip("\n")
    if not line.strip():
        print()
    elif "──" in line:
        print(RULE + line + OFF)
    elif re.match(r"^ [A-Z][A-Z0-9 ]*(\(.*\))?\s*$", line) or line.startswith(" DECK CHEAT SHEET"):
        print(HDR + line + OFF)
    else:
        m = re.match(r"^ (\S+(?: \S+)*?)(\s{2,})(.*)$", line)
        if not m:
            m = re.match(r"^ (\S+)(\s*)(.*)$", line)
        if m and not line.startswith("  "):
            print(" " + CMD + m.group(1) + OFF + m.group(2)
                  + BODY + emphasise(m.group(3), BODY) + OFF)
        else:
            print(CONT + emphasise(line, CONT) + OFF)
