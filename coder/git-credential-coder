#!/usr/bin/env bash
set -uo pipefail

token() {
  local env_file="$HOME/.config/coder-setup/agent.env" coder_bin
  if [ -r "$env_file" ]; then
    set -a
    . "$env_file"
    set +a
  fi
  coder_bin=$(command -v coder || echo "$HOME/.coder/coder")
  "$coder_bin" external-auth access-token github 2>/dev/null
}

case "${1:-}" in
  get)
    host=""
    protocol=""
    while IFS='=' read -r key value; do
      [ -z "$key" ] && break
      case "$key" in
        host) host="$value" ;;
        protocol) protocol="$value" ;;
      esac
    done
    [ "$protocol" = https ] && [ "$host" = github.com ] || exit 0
    value=$(token) || exit 0
    [ -n "$value" ] || exit 0
    printf 'username=x-access-token\npassword=%s\n' "$value"
    ;;
  token)
    token
    ;;
esac
exit 0
