#!/usr/bin/env bash
set -o pipefail

[ -d "$HOME/.local/google-cloud-sdk/bin" ] && PATH="$HOME/.local/google-cloud-sdk/bin:$PATH"
if [ $# -gt 0 ] && ! command -v "$1" >/dev/null 2>&1; then
  echo "vertex-session: $1 is not a command. Shell aliases do not work here, so pass the real command, e.g. vertex-session opencode" >&2
  exit 127
fi

base=$(cd "${VERTEX_SESSION_TMP:-/tmp}" && pwd -P) || exit 1
prefix="$base/vertex-login."

alive() {
  local pid
  pid=$(cat "$1/pid" 2>/dev/null) && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

clean() {
  if [ -d "$1/gcloud" ]; then
    CLOUDSDK_CONFIG="$1/gcloud" gcloud auth application-default revoke --quiet >/dev/null 2>&1
    CLOUDSDK_CONFIG="$1/gcloud" gcloud auth revoke --all --quiet >/dev/null 2>&1
  fi
  rm -rf "$1"
}

opencode_wrapper() {
  local real
  real=$(command -v opencode) || return 0
  mkdir -p "$dir/bin" || return 1
  printf '#!/usr/bin/env bash\nexec %q --standalone "$@"\n' "$real" > "$dir/bin/opencode" || return 1
  chmod +x "$dir/bin/opencode" && PATH="$dir/bin:$PATH"
}

for old in "$prefix"*; do
  [ -d "$old" ] && [ -O "$old" ] && ! alive "$old" && clean "$old"
done

dir=$(mktemp -d "${prefix}XXXXXX") || exit 1
chmod 700 "$dir"
trap 'clean "$dir"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
echo "$$" > "$dir/pid"
mkdir "$dir/gcloud"
export CLOUDSDK_CONFIG="$dir/gcloud"
export GOOGLE_APPLICATION_CREDENTIALS="$dir/gcloud/application_default_credentials.json"
opencode_wrapper || exit 1

if ! gcloud auth login --no-launch-browser --update-adc; then
  echo "vertex-session: login failed" >&2
  exit 1
fi
echo "vertex-session: Google login is on until you quit, then it is revoked. Chat history is kept, so do production data work in prod-data-session instead." >&2

if [ $# -gt 0 ]; then
  "$@"
else
  "${SHELL:-bash}" -i
fi
exit $?
