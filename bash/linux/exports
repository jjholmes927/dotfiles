for _dir in "$HOME/.rbenv/bin" "$HOME/.local/go/bin" "$HOME/.local/bin"; do
  case ":$PATH:" in
    *":$_dir:"*) ;;
    *) PATH="$_dir:$PATH" ;;
  esac
done
unset _dir
export PATH

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
command -v rbenv >/dev/null 2>&1 && eval "$(rbenv init - --no-rehash bash)"

export LD_DEV_SERVER=true
export GOOD_CODE_CHECKLIST="$HOME/.config/good-code/good-code.md"
export LANG=en_GB.UTF-8
export LC_ALL=en_GB.UTF-8

if [[ $- == *i* && -r "$HOME/.local/state/coder-setup/status" ]]; then
  grep -E ' (FAIL|RUNNING|SKIP)( |$)' "$HOME/.local/state/coder-setup/status" | sed 's/^/coder-setup: /'
fi
