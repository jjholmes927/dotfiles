deck() {
  local name=${1:-interpret} root="${ENG_ROOT:-$HOME/engineering}" cheat fleet right ops w h ch
  cheat="$(dirname "$(readlink "$HOME/.tmux.conf" 2>/dev/null)")/deck-cheat"
  if ! tmux has-session -t "=$name" 2>/dev/null; then
    if [ -n "$TMUX" ]; then
      w=$(tmux display -p '#{client_width}'); h=$(tmux display -p '#{client_height}')
    else
      w=$(tput cols 2>/dev/null || echo 200); h=$(tput lines 2>/dev/null || echo 60)
    fi
    [ "${w:-0}" -ge 120 ] 2>/dev/null || w=200; [ "${h:-0}" -ge 35 ] 2>/dev/null || h=60
    fleet=$(tmux new-session -d -s "$name" -c "$root" -n deck -x "$w" -y "$h" -P -F '#{pane_id}')
    tmux set-option -w -t "=$name:deck" automatic-rename off
    tmux send-keys -t "$fleet" "claude agents --cwd \"$root\" --dangerously-skip-permissions" C-m
    right=$(tmux split-window -h -l 56 -t "$fleet" -c "$root" -P -F '#{pane_id}')
    ops=$(tmux split-window -v -l 14 -t "$right" -c "$root" -P -F '#{pane_id}')
    if [ -x "$cheat" ]; then
      ch=$(tmux display -p -t "$right" '#{pane_height}')
      tmux send-keys -t "$right" "clear; \"$cheat\" | head -n $((ch-4))" C-m
    fi
    tmux send-keys -t "$ops" 'clone-status' C-m
    tmux select-pane -t "$fleet"
    tmux new-window -t "=$name" -n pair -c "$root"
    tmux select-window -t "=$name:deck"
  fi
  tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
  if [ -n "$TMUX" ]; then tmux switch-client -t "=$name"; else tmux attach -t "=$name"; fi
}

_agent_pick() {
  claude agents --json 2>/dev/null | python3 -c '
import json,sys
q=(sys.argv[1] if len(sys.argv)>1 else "").lower()
try: rows=json.load(sys.stdin)
except Exception: rows=[]
rows=[r for r in rows if r.get("sessionId")]
for r in rows: r["short"]=r["sessionId"][:8]
me=(sys.argv[2] if len(sys.argv)>2 else "")
rows=[r for r in rows if r["sessionId"]!=me]
if q:
    hits=[r for r in rows if r["short"].startswith(q)] \
      or [r for r in rows if q in (r.get("name") or "").lower()]
else:
    hits=[r for r in rows if r.get("kind")=="background"]
if len(hits)==1:
    print("OK", hits[0]["short"], hits[0].get("name") or "")
else:
    print("AMBIGUOUS" if hits else "NONE")
    for r in (hits or rows):
        print("  %-9s %-11s %-7s %s" % (r["short"], r.get("kind",""), r.get("status",""), r.get("name") or ""))
' "$1" "${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-}}"
}

pair() {
  local res; res=$(_agent_pick "$1")
  local verdict; verdict=$(printf '%s' "$res" | head -1 | awk '{print $1}')
  if [ "$verdict" != "OK" ]; then
    printf '%s\n' "$res" | sed '1s/^NONE$/no match — running sessions:/;1s/^AMBIGUOUS$/more than one match:/'
    return 1
  fi
  local id; id=$(printf '%s' "$res" | head -1 | awk '{print $2}')
  local nm; nm=$(printf '%s' "$res" | head -1 | cut -d' ' -f3-)
  if [ -z "$TMUX" ]; then claude attach "$id"; return; fi
  if ! tmux list-windows -F '#W' | grep -qx pair; then
    echo "no 'pair' window in this session — run deck first"; return 1
  fi
  local cmd; cmd=$(tmux display-message -p -t ':pair' '#{pane_current_command}')
  case "$cmd" in
    bash|zsh|sh) ;;
    *) echo "pair window is busy running '$cmd' — detach it first (<-)"; return 1 ;;
  esac
  tmux send-keys -t ':pair' C-u
  tmux send-keys -t ':pair' "claude attach $id" C-m
  tmux select-window -t ':pair'
  echo "pair -> $id  $nm"
}
