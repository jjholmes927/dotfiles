stream() {
  local lane=$1 name=$2; shift 2
  local effort=high
  if [ "$1" = "--effort" ]; then effort=$2; shift 2; fi
  local prompt="$*"
  local root=$HOME/engineering/$lane
  if [ ! -d "$root" ]; then echo "no such lane: $lane" >&2; return 1; fi
  if [ -z "$prompt" ]; then echo "usage: stream <lane> <branch-name> [--effort high|low] <prompt>" >&2; return 1; fi
  (cd "$root" && bin/create_worktree "$name") || return 1
  (cd "$root/.worktrees/$name" && claude --bg --name "${name#jjholmes927-}" --effort "$effort" "$prompt")
}
