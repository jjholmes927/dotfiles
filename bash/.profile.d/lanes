_lane_default_branch() {
  local b
  b=$(git -C "$1" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
  b=${b#origin/}
  echo "${b:-main}"
}

_lane_live() {
  claude agents --json 2>/dev/null | python3 -c '
import json,sys
try: rows=json.load(sys.stdin)
except Exception: rows=[]
print(sum(1 for r in rows if r.get("kind")=="interactive" and r.get("cwd")==sys.argv[1]))' "$1" 2>/dev/null || echo 0
}

lane-sweep() {
  local lane=$1 root=${ENG_ROOT:-$HOME/engineering}/$1
  if [ ! -d "$root" ]; then echo "no such lane: $lane" >&2; return 1; fi
  if [ "$(_lane_live "$root")" != "0" ]; then echo "SKIP $lane: live claude session in lane root" >&2; return 2; fi
  local branch dirty base
  base=$(_lane_default_branch "$root")
  branch=$(git -C "$root" branch --show-current)
  dirty=$(git -C "$root" status --porcelain | wc -l | tr -d ' ')
  if [ "$branch" = "$base" ] && [ "$dirty" = "0" ]; then return 0; fi
  git -C "$root" fetch origin "$base" --quiet
  if [ "$branch" = "$base" ]; then
    branch="jjholmes927-lane-sweep-$lane-$(date +%Y%m%d)"
    git -C "$root" branch "$branch" || return 1
  fi
  local stashed=0
  if [ "$dirty" != "0" ]; then
    git -C "$root" stash push -u -m "lane-sweep $lane $branch $(date +%F)" || return 1
    stashed=1
  fi
  git -C "$root" checkout "$base" --quiet || return 1
  if [ ! -d "$root/.worktrees/$branch" ]; then
    git -C "$root" worktree add "$root/.worktrees/$branch" "$branch" --quiet || return 1
  fi
  if [ "$stashed" = "1" ]; then
    if git -C "$root/.worktrees/$branch" stash pop --quiet; then
      echo "$lane: WIP moved to .worktrees/$branch"
    else
      echo "$lane: WIP kept in stash (pop conflicted) — resolve in .worktrees/$branch" >&2
    fi
  else
    echo "$lane: parked branch moved to .worktrees/$branch"
  fi
}

gmp-all() {
  local lane root rc
  for lane in ${LANES:-mn1 mn2 mn3 mn4 mn5}; do
    root=${ENG_ROOT:-$HOME/engineering}/$lane
    [ -d "$root" ] || continue
    if [ "$(git -C "$root" branch --show-current)" != "$(_lane_default_branch "$root")" ] || [ -n "$(git -C "$root" status --porcelain | head -1)" ]; then
      lane-sweep "$lane"; rc=$?
      if [ "$rc" != "0" ]; then echo "SKIP $lane: needs sweep but $([ "$rc" = "2" ] && echo "a live session is in the lane root" || echo "sweep failed")"; continue; fi
    fi
    git -C "$root" fetch origin "$(_lane_default_branch "$root")" --quiet
    if git -C "$root" pull --ff-only --quiet 2>/dev/null; then
      echo "$lane: main @ $(git -C "$root" log --oneline -1 | cut -c1-60)"
    else
      echo "SKIP $lane: pull --ff-only failed"
    fi
  done
}

clone-status() {
  local lane root branch dirty behind wts live
  printf '%-5s %-42s %6s %7s %4s %5s\n' LANE BRANCH DIRTY BEHIND WTS LIVE
  for lane in ${LANES:-mn1 mn2 mn3 mn4 mn5}; do
    root=${ENG_ROOT:-$HOME/engineering}/$lane
    [ -d "$root" ] || continue
    git -C "$root" fetch origin "$(_lane_default_branch "$root")" --quiet 2>/dev/null
    branch=$(git -C "$root" branch --show-current)
    dirty=$(git -C "$root" status --porcelain | wc -l | tr -d ' ')
    behind=$(git -C "$root" rev-list --count "$(_lane_default_branch "$root")..origin/$(_lane_default_branch "$root")" 2>/dev/null || echo '?')
    wts=$(git -C "$root" worktree list | grep -c worktrees)
    live=$(_lane_live "$root")
    printf '%-5s %-42s %6s %7s %4s %5s\n' "$lane" "$branch" "$dirty" "$behind" "$wts" "$live"
  done
}
